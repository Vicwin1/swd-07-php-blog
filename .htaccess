Options -Indexes -MultiViews
DirectoryIndex index.php

RewriteEngine On
RewriteBase /swd/07-php-blog/
RewriteRule ^post/([^/]+)/?$ post.php?slug=$1 [B,L,QSA]
RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [B,L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]

<FilesMatch "^(?:database\.sql|seed\.php)$">
    Require all denied
</FilesMatch>